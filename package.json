{
  "name": "time-mcp",
  "version": "0.2.0",
  "description": "MCP server for current time, timers, stopwatches, and alarms",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "time-mcp": "dist/index.js",
    "time-mcp-notify-hook": "dist/notify-hook.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "npm run bundle:server && npm run bundle:hook",
    "bundle:server": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=bundle/index.mjs",
    "bundle:hook": "esbuild src/notify-hook.ts --bundle --platform=node --format=esm --target=node24 --outfile=bundle/notify-hook.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrono-node": "^2.10.1",
    "luxon": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
