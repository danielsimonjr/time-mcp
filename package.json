{
  "name": "time-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "MCP server for current time, timers, stopwatches, and alarms",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "time-mcp": "dist/index.js",
    "time-mcp-notify-hook": "dist/notify-hook.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  },
  "dependencies": {
    "chrono-node": "^2.10.1",
    "luxon": "^3.4.0",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
